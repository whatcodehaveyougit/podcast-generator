# podcast-digest local settings. Copy to .env (project root) and fill in.
# .env is gitignored and never served (the feed server serves only podcast-digest/public/).

# Optional: Tailscale auth key, only to join a machine to the tailnet without signing in
# (`tailscale up --authkey ...`). Nothing in the podcast script reads it. Preferred: the keychain,
#   security add-generic-password -s podcast-digest-tailscale -a authkey -w
# TS_AUTHKEY=
