# podcast-digest local settings. Copy to .env (project root) and fill in.
# .env is gitignored and never served (the feed server serves only podcast-digest/public/).

# Cloudflare R2 bucket for the feeds (R2 > bucket > Settings)
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_BUCKET=podcast-digest
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional: the random folder the feeds live under (default: audio.cloud.prefix in settings.json)
# R2_PREFIX=

# R2 API keys. Preferred: keep them in the macOS keychain instead, and leave these out:
#   security add-generic-password -s podcast-digest-r2 -a access_key_id -w
#   security add-generic-password -s podcast-digest-r2 -a secret_access_key -w
# If set here, they override the keychain.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
